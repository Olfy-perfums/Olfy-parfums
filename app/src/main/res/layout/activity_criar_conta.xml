<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".criarConta">

    <TextView
        android:id="@+id/textView5"
        android:layout_width="162dp"
        android:layout_height="18dp"
        android:text="Já tem uma conta? Entrar"
        tools:layout_editor_absoluteX="124dp"
        tools:layout_editor_absoluteY="662dp" />

    <EditText
        android:id="@+id/edtConfirmarSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="textPassword"
        android:text="Senha"
        tools:layout_editor_absoluteX="100dp"
        tools:layout_editor_absoluteY="532dp" />

    <EditText
        android:id="@+id/edtCriaNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Nome"
        tools:layout_editor_absoluteX="100dp"
        tools:layout_editor_absoluteY="325dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crie sua conta"
        tools:layout_editor_absoluteX="160dp"
        tools:layout_editor_absoluteY="287dp" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/logo"
        tools:layout_editor_absoluteX="132dp"
        tools:layout_editor_absoluteY="50dp" />

    <EditText
        android:id="@+id/edtRecuperarEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Email"
        tools:layout_editor_absoluteX="100dp"
        tools:layout_editor_absoluteY="394dp" />

    <EditText
        android:id="@+id/edtSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="textPassword"
        android:text="Senha"
        tools:layout_editor_absoluteX="99dp"
        tools:layout_editor_absoluteY="462dp" />

    <Button
        android:id="@+id/btnCriarConta"
        android:layout_width="170dp"
        android:layout_height="53dp"
        android:text="Criar Conta"
        tools:layout_editor_absoluteX="120dp"
        tools:layout_editor_absoluteY="593dp" />

</androidx.constraintlayout.widget.ConstraintLayout>